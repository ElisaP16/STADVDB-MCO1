<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Drill Down SQL query dimensions and results.">
    <title>Drill Down — OLAP Queries</title>
    <link rel="stylesheet" href="styles.css">
  </head>
  <body>
    <main class="shell">
      <section class="workspace">
        <div class="detail-page">
          <a class="back-link" href="index.html">← Back to all queries</a>
          <header class="detail-heading">
            <span class="query-icon blue">&lt;/&gt;</span>
            <div><p class="eyebrow">QUERY 2</p><h1>Drill Down</h1><p class="heading-copy">Explore transaction totals from years down to individual weekdays.</p></div>
          </header>
          <section class="detail-section">
            <div class="section-heading"><span class="section-number">01</span><div><h2>Query setup</h2><p>Choose the level of time detail.</p></div></div>
            <div class="query-options" aria-label="Drill down level">
              <button data-level="quarter">Year → quarter</button>
              <button class="active" data-level="month">Quarter → month</button>
              <button data-level="day">Month → day</button>
            </div>
            <div class="results-wrap empty-results"><span class="empty-mark">∅</span><strong>Month level ready</strong><p>Run the SQL against the warehouse to display the result rows here.</p></div>
          </section>
        </div>
      </section>
    </main>
    <script>
      const levelButtons = document.querySelectorAll(".query-options button");
      const levelOutput = document.querySelector(".empty-results strong");
      levelButtons.forEach((button) => {
        button.addEventListener("click", () => {
          levelButtons.forEach((item) => item.classList.toggle("active", item === button));
          levelOutput.textContent = `${button.dataset.level[0].toUpperCase()}${button.dataset.level.slice(1)} level ready`;
        });
      });
    </script>
  </body>
</html>
