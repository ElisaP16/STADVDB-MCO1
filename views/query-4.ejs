<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Dice SQL query dimensions and results.">
    <title>Dice — OLAP Queries</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
      /* Move these into styles.css if you prefer */
      .mode-toggle { display: flex; gap: 1.25rem; flex-wrap: wrap; margin: 0 0 1rem; }
      .run-btn { margin-top: 1rem; padding: .6rem 1.25rem; font: inherit; font-weight: 600; cursor: pointer; }
      .results-scroll { overflow-x: auto; }
      .results-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
      .results-table th, .results-table td { padding: .5rem .75rem; text-align: left; border-bottom: 1px solid rgba(128,128,128,.3); }
      .results-table th { text-transform: capitalize; }
      .results-table td.num { text-align: right; font-variant-numeric: tabular-nums; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <main class="shell">
      <section class="workspace">
        <div class="detail-page">
          <a class="back-link" href="/">← Back to all queries</a>
          <header class="detail-heading">
            <span class="query-icon amber">&lt;/&gt;</span>
            <div><p class="eyebrow">QUERY 4</p><h1>Dice</h1><p class="heading-copy">Filter a sub-cube by two years, two districts, and either two transaction types or two transaction purposes.</p></div>
          </header>

          <section class="detail-section">
            <div class="section-heading"><span class="section-number">01</span><div><h2>Query setup</h2><p>Choose the values passed into the query placeholders.</p></div></div>

            <form method="get" action="/query-4">
              <input type="hidden" name="run" value="1">

              <div class="mode-toggle" role="radiogroup" aria-label="Dice by">
                <label><input type="radio" name="mode" value="type" <%= q.mode === 'type' ? 'checked' : '' %>> Transaction type</label>
                <label><input type="radio" name="mode" value="ksymbol" <%= q.mode === 'ksymbol' ? 'checked' : '' %>> Transaction purpose</label>
              </div>

              <div class="dice-controls">
                <fieldset><legend>Years</legend><div class="field-row">
                  <% ['year1', 'year2'].forEach((name, i) => { %>
                    <select name="<%= name %>" aria-label="Year <%= i + 1 %>">
                      <% options.years.forEach(y => { %>
                        <option <%= y === q[name] ? 'selected' : '' %>><%= y %></option>
                      <% }) %>
                    </select>
                  <% }) %>
                </div></fieldset>

                <fieldset><legend>Districts</legend><div class="field-row">
                  <% ['district1', 'district2'].forEach((name, i) => { %>
                    <select name="<%= name %>" aria-label="District <%= i + 1 %>">
                      <% options.districts.forEach(d => { %>
                        <option <%= d === q[name] ? 'selected' : '' %>><%= d %></option>
                      <% }) %>
                    </select>
                  <% }) %>
                </div></fieldset>

                <fieldset id="type-fieldset" <%= q.mode === 'type' ? '' : 'hidden' %>>
                  <legend>Transaction types</legend>
                  <div class="fixed-values"><span>Credit</span><span>Debit</span></div>
                </fieldset>

                <fieldset id="ksymbol-fieldset" <%= q.mode === 'ksymbol' ? '' : 'hidden' %>>
                  <legend>Transaction purposes</legend>
                  <div class="field-row">
                    <% ['k1', 'k2'].forEach((name, i) => { %>
                      <select name="<%= name %>" aria-label="Purpose <%= i + 1 %>">
                        <% options.kSymbols.forEach(k => { %>
                          <option <%= k === q[name] ? 'selected' : '' %>><%= k %></option>
                        <% }) %>
                      </select>
                    <% }) %>
                  </div>
                </fieldset>
              </div>

              <div class="run-btn-container">
                <button class="run-btn" type="submit">Run Query</button>
              </div>
            </form>

            <div class="results-wrap <%= rows && rows.length ? '' : 'empty-results' %>" aria-label="Dice query results" aria-live="polite">
              <% if (error) { %>
                <strong>Could not load results</strong><p><%= error %></p>
              <% } else if (rows === null) { %>
                <span class="empty-mark">∅</span><strong>Sub-cube ready to query</strong>
                <p>2 years · 2 districts · 2 values</p>
              <% } else if (rows.length === 0) { %>
                <strong>No rows</strong><p>The sub-cube is empty for these selections.</p>
              <% } else { %>
                <% const cols = Object.keys(rows[0]); %>
                <div class="results-scroll"><table class="results-table">
                  <thead><tr><% cols.forEach(c => { %><th class="<%= c === 'number_of_transactions' ? 'num' : '' %>"><%= c.replace(/_/g, ' ') %></th><% }) %></tr></thead>
                  <tbody>
                    <% rows.forEach(r => { %>
                      <tr><% cols.forEach(c => { %>
                        <% const isNum = c === 'number_of_transactions' || (typeof r[c] === 'number' && c !== 'year'); %>
                        <td class="<%= isNum ? 'num' : '' %>"><%= isNum ? r[c].toLocaleString() : r[c] %></td>
                      <% }) %></tr>
                    <% }) %>
                  </tbody>
                </table></div>
              <% } %>
            </div>
          </section>
        </div>
      </section>
    </main>

    <script>
      // Show only the fieldset that belongs to the selected query
      document.querySelectorAll('input[name="mode"]').forEach((radio) =>
        radio.addEventListener('change', () => {
          const isType = radio.value === 'type';
          document.getElementById('type-fieldset').hidden = !isType;
          document.getElementById('ksymbol-fieldset').hidden = isType;
        })
      );
    </script>
  </body>
</html>
