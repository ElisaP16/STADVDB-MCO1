<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Roll-up SQL query dimensions and results.">
    <title>Roll-up — OLAP Queries</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <main class="shell">
      <section class="workspace">
        <div class="detail-page">
          <a class="back-link" href="/">← Back to all queries</a>
          <header class="detail-heading">
            <span class="query-icon violet">&lt;/&gt;</span>
            <div><p class="eyebrow">QUERY 1</p><h1>Roll-up</h1><p class="heading-copy">Group district-level transactions into regional totals.</p></div>
          </header>
          <section class="detail-section">
            <div class="section-heading"><span class="section-number">01</span><div><h2>Query setup</h2><p>Pick a roll-up operation, then run the predefined SQL against <code>star_schema</code>.</p></div></div>

            <form method="get" action="/query-1" class="olap-query-form">
              <input type="hidden" name="run" value="1">
              <%- include('partials/operation-toggle', {
                operations,
                operation,
                ariaLabel: 'Roll-up operation'
              }) %>
              <div class="run-btn-container">
                <button class="run-btn" type="submit">Run Query</button>
              </div>
            </form>

            <%- include('partials/results-table', {
              rows,
              columns,
              error,
              emptyTitle: 'Regional totals ready',
              emptyMessage: 'Run the SQL against the warehouse to display the result rows here.'
            }) %>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>
