<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Slice SQL query dimensions and results.">
    <title>Slice — OLAP Queries</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <main class="shell">
      <section class="workspace">
        <div class="detail-page">
          <a class="back-link" href="/">← Back to all queries</a>
          <header class="detail-heading">
            <span class="query-icon emerald">&lt;/&gt;</span>
            <div><p class="eyebrow">QUERY 3</p><h1>Slice</h1><p class="heading-copy">Fix transaction type to credit or debit and inspect the remaining dimensions.</p></div>
          </header>
          <section class="detail-section">
            <div class="section-heading"><span class="section-number">01</span><div><h2>Query setup</h2><p>Choose the transaction type passed into the query.</p></div></div>

            <form method="get" action="/query-3" class="olap-query-form">
              <input type="hidden" name="run" value="1">
              <%- include('partials/operation-toggle', {
                operations,
                operation,
                ariaLabel: 'Transaction type',
                legendText: 'Transaction type'
              }) %>
              <div class="run-btn-container">
                <button class="run-btn" type="submit">Run Query</button>
              </div>
            </form>

            <%- include('partials/results-table', {
              rows,
              columns,
              error,
              emptyTitle: 'Slice ready',
              emptyMessage: 'Results will contain year, district name, and transaction count.'
            }) %>
          </section>
        </div>
      </section>
    </main>
  </body>
</html>
